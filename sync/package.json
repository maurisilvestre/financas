{
  "name": "financas-sync",
  "version": "0.1.0",
  "private": true,
  "description": "Sincroniza contas, transações e faturas do Meu Pluggy (Open Finance) para o Postgres local.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node src/main.ts daemon",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test --test-concurrency=1 --test-timeout=120000 test/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.2.0",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "typescript": "7.0.2"
  }
}
