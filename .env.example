# O jeito fácil:  ./scripts/configurar.sh   (cria o .env, gera as senhas e pergunta o resto)
# Ou à mão:       cp .env.example .env && chmod 600 .env
# O .env nunca vai para o git (está no .gitignore). Não cole o conteúdo dele em chats nem em issues.

# --- Postgres ---------------------------------------------------------------
# Gere senhas com:  openssl rand -hex 24   (o configurar.sh já faz isso)
# Atenção: as senhas dos papéis são aplicadas só no PRIMEIRO start do banco.
# Para trocar depois, veja docs/operacao.md.
POSTGRES_SUPERUSER_PASSWORD=
APP_DB_PASSWORD=
READONLY_DB_PASSWORD=
# Papel de escrita do app e do MCP (só a camada do usuário: categorias, regras, metas...).
MCP_DB_PASSWORD=
# Porta do Postgres na sua máquina (só 127.0.0.1)
DB_PORT=5432
# Porta do app web na sua máquina (só 127.0.0.1): http://127.0.0.1:8737
WEB_PORT=8737
# Nomes extras aceitos pelo app, para abrir de outro aparelho por um proxy HTTPS como o
# "tailscale serve" (ex.: servidor.tail0000.ts.net). Nomes exatos, separados por vírgula, sem
# curinga. Vazio = só 127.0.0.1/localhost. Veja docs/servidor.md.
WEB_ALLOWED_HOSTS=

# --- Pluggy -----------------------------------------------------------------
# Passo a passo em docs/pluggy.md. dashboard.pluggy.ai → sua aplicação → aba "Aplicação"
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# IDs dos items (uma conexão MeuPluggy por banco), separados por vírgula.
# Depois de preencher, confira com:  docker compose run --rm sync check
PLUGGY_ITEM_IDS=

# --- Sync -------------------------------------------------------------------
# Horários (Brasília). O Meu Pluggy atualiza com os bancos a cada 24 h.
SYNC_TIMES=07:17,19:17
# Janela de cada sync (dias para trás). A primeira vez busca SYNC_INITIAL_LOOKBACK_DAYS.
SYNC_LOOKBACK_DAYS=120
SYNC_INITIAL_LOOKBACK_DAYS=365
SYNC_ON_START=true
LOG_LEVEL=info

# --- Backup -----------------------------------------------------------------
BACKUP_TIME=03:23
BACKUP_RETENTION_DAYS=30
# Chave pública do age (age1...). Gere com:  age-keygen -o ~/.config/financas-backup.key
# Guarde a chave PRIVADA fora deste projeto (gerenciador de senhas). Sem ela, não há restore.
# Sem a chave pública, o backup fica SEM criptografia. Veja docs/backup.md.
BACKUP_AGE_RECIPIENT=

# --- Classificação por IA (opcional) ------------------------------------------
# Sugere categorias (Claude Haiku) para o que nenhuma regra pegou, depois de cada sync.
# Vão para a API da Anthropic só descrição, valor e data. Nada muda até você aplicar no app.
# Chave em platform.claude.com → API Keys. Sem a chave, a classificação fica desligada.
ANTHROPIC_API_KEY=
CLASSIFY_MODEL=claude-haiku-5-5
# Seu nome como aparece nos Pix (ajuda a reconhecer transferências entre suas contas). Opcional.
CLASSIFY_OWNER_NAME=
CLASSIFY_AFTER_SYNC=true
